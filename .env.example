# ──────────────────────────────────────────────────
# SportsPulse — Environment Variables
# ──────────────────────────────────────────────────
# 1. Copy:   cp .env.example .env
# 2. Get key: rapidapi.com → Subscribe to Cricbuzz Cricket API (free)
#             → My Apps → Application Keys → copy key
# 3. Paste key below (no quotes needed)

CRICBUZZ_API_KEY=your_rapidapi_key_here
